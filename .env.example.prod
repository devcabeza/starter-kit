# ============================================================
# .env.example.prod — Production Environment Variables
# ============================================================
# Copy this file to .env.prod and fill in the values.
# For Coolify: set these in the Environment Variables UI.
# ============================================================

# --- Application ---
APP_NAME="${APP_NAME}"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# --- Performance ---
BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_URL=

# --- Session ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Broadcasting ---
BROADCAST_CONNECTION=log

# --- Filesystem ---
FILESYSTEM_DISK=local

# --- Queue ---
QUEUE_CONNECTION=redis

# --- Cache ---
CACHE_STORE=redis
CACHE_PREFIX=laravertex-cache

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_URL=

# --- Mail (Sendrix Proxy) ---
MAIL_MAILER=sendrix
MAIL_FROM_ADDRESS="noreply@${APP_URL}"
MAIL_FROM_NAME="${APP_NAME}"

SENDRIX_BASE_URL="https://sendrix.alejandrocabeza.dev"
SENDRIX_API_KEY=
SENDRIX_PROJECT_ID=

# --- AWS S3 (Optional — for file storage) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Vite (built at build time, not needed at runtime) ---
# VITE_APP_NAME="${APP_NAME}"
