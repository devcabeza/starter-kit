# ============================================================
# Dockerfile.prod — Laravel for Coolify (nginx + php-fpm)
# ============================================================

# --- Stage 1: Build frontend assets ---
FROM node:22-slim AS frontend

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY vite.config.js ./
COPY resources/ resources/
RUN npm run build


# --- Stage 2: Install PHP dependencies ---
FROM composer:2 AS deps

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --prefer-dist \
    --ignore-platform-req=ext-pcntl \
    && composer dump-autoload --optimize --no-dev --no-scripts


# --- Stage 3: Final production image (nginx + php-fpm) ---
FROM php:8.4-fpm-bookworm

# Install nginx and system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       nginx \
       curl \
       unzip \
       git \
       libicu-dev \
       libzip-dev \
       libpng-dev \
       libjpeg-dev \
       libfreetype6-dev \
       libssl-dev \
       libpq-dev \
       libonig-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
       pcntl \
       opcache \
       pdo \
       pdo_pgsql \
       pgsql \
       intl \
       zip \
       gd \
       exif \
       bcmath \
       mbstring \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# PHP production settings
RUN echo "opcache.enable=1\n\
opcache.memory_consumption=256\n\
opcache.interned_strings_buffer=16\n\
opcache.max_accelerated_files=20000\n\
opcache.revalidate_freq=0\n\
opcache.validate_timestamps=0\n\
opcache.save_comments=1\n\
opcache.jit=tracing\n\
opcache.jit_buffer_size=256M\n\
memory_limit=512M\n\
upload_max_filesize=64M\n\
post_max_size=64M" > /usr/local/etc/php/conf.d/laravel-production.ini

# Configure php-fpm to run as app user
RUN sed -i 's/^user = www-data/user = app/' /usr/local/etc/php-fpm.d/www.conf \
    && sed -i 's/^group = www-data/group = app/' /usr/local/etc/php-fpm.d/www.conf

# Override zz-docker.conf to listen on unix socket (this file overrides www.conf)
RUN printf '[www]\nlisten = /var/run/php/php8.4-fpm.sock\nlisten.owner = app\nlisten.group = app\n' > /usr/local/etc/php-fpm.d/zz-docker.conf

# Nginx configuration
RUN rm /etc/nginx/sites-enabled/default
COPY docker/prod/nginx.conf /etc/nginx/sites-available/laravel.conf
RUN ln -s /etc/nginx/sites-available/laravel.conf /etc/nginx/sites-enabled/laravel.conf

# Non-root user for app files
RUN groupadd -g 1000 -r app && useradd -g 1000 -r -s /bin/false app
# Make nginx run as app user (so it can access php-fpm unix socket)
RUN sed -i "s/^user www-data/user app/" /etc/nginx/nginx.conf

# Create php-fpm run directory with correct ownership
RUN mkdir -p /var/run/php && chown app:app /var/run/php

WORKDIR /var/www/html

# Composer dependencies (from deps stage)
COPY --from=deps /app/vendor vendor/
COPY --from=deps /app/composer.json composer.json

# Application code
COPY app/ app/
COPY bootstrap/ bootstrap/
COPY config/ config/
COPY database/ database/
COPY public/ public/
COPY resources/ resources/
COPY routes/ routes/
COPY artisan artisan

# Copy built frontend assets
COPY --from=frontend /app/dist/ public/build/

# Recreate storage/cache directories (excluded by .dockerignore)
RUN mkdir -p storage/framework/{sessions,views,cache} \
    bootstrap/cache \
    && chown -R app:app /var/www/html \
    && chmod -R 775 storage bootstrap/cache

# Entrypoint
COPY docker/prod/entrypoint-prod.sh /usr/local/bin/entrypoint-prod
RUN chmod +x /usr/local/bin/entrypoint-prod

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || grep -qs "horizon" /proc/[0-9]*/cmdline || exit 1

ENTRYPOINT ["entrypoint-prod"]
CMD ["nginx", "-g", "daemon off;"]
