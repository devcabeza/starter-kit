{
    "listeners": {
        "*:8000": {
            "pass": "routes",
            "forwarded": {
                "protocol": "X-Forwarded-Proto",
                "source": ["0.0.0.0/0"]
            }
        }
    },
    "routes": [
        {
            "match": {
                "uri": "!/index.php"
            },
            "action": {
                "share": "/var/www/html/public$uri",
                "fallback": {
                    "pass": "applications/laravel"
                }
            }
        },
        {
            "match": {
                "uri": "/index.php"
            },
            "action": {
                "pass": "applications/laravel"
            }
        }
    ],
    "applications": {
        "laravel": {
            "type": "php",
            "root": "/var/www/html/public/",
            "script": "index.php",
            "user": "app",
            "workers": {
                "count": "auto",
                "max": 10,
                "limits": {
                    "timeout": 120
                }
            }
        }
    }
}
